{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/qualify-environmental-evidence/schemas/agent-execution-receipt.schema.json",
  "title": "Bounded Agent Execution Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_schema_version",
    "workflow_id",
    "request_sha256",
    "max_steps",
    "steps",
    "final_status",
    "stop_reason",
    "network_access",
    "external_action_count",
    "evidence_snapshot_sha256s",
    "result_sha256",
    "receipt_sha256"
  ],
  "properties": {
    "receipt_schema_version": {"const": "1.0.0"},
    "workflow_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "max_steps": {"type": "integer", "minimum": 1, "maximum": 20},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step",
          "action",
          "session_status",
          "checkpoint_sequence",
          "checkpoint_sha256",
          "completed_stages",
          "evidence_snapshot_count",
          "verified"
        ],
        "properties": {
          "step": {"type": "integer", "minimum": 1},
          "action": {"enum": ["VALIDATE_REQUEST", "SNAPSHOT_EVIDENCE", "QUALIFY", "REPLAY_VERIFY"]},
          "session_status": {"enum": ["PAUSED", "COMPLETED", "REPLAYED"]},
          "checkpoint_sequence": {"type": "integer", "minimum": 1},
          "checkpoint_sha256": {"$ref": "#/$defs/sha256"},
          "completed_stages": {
            "type": "array",
            "uniqueItems": true,
            "items": {"enum": ["REQUEST_VALIDATED", "EVIDENCE_SNAPSHOTTED", "COMPLETE"]}
          },
          "evidence_snapshot_count": {"type": "integer", "minimum": 0},
          "result_sha256": {"$ref": "#/$defs/sha256"},
          "verified": {"const": true}
        }
      }
    },
    "final_status": {"enum": ["COMPLETED", "REPLAYED", "PAUSED"]},
    "stop_reason": {"enum": ["TERMINAL_RESULT", "ALREADY_COMPLETE", "STEP_BUDGET_EXHAUSTED"]},
    "network_access": {"const": false},
    "external_action_count": {"const": 0},
    "evidence_snapshot_sha256s": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "result_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
