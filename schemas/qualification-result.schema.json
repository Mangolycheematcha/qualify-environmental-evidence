{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/qualify-environmental-evidence/schemas/qualification-result.schema.json",
  "title": "Deterministic Evidence Qualification Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "request_id", "project_id", "claim_family", "workflow_status",
    "qualification", "reason_codes", "bounded_statement", "evidence_refs", "retrieval_trace",
    "assurance_checks", "must_not_claim", "limitations", "human_review_required",
    "memory_snapshot_sha256", "result_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "request_id": {"type": "string"},
    "project_id": {"type": "string"},
    "claim_family": {"type": "string"},
    "workflow_status": {"enum": ["QUALIFIED", "ABSTAINED", "REFUSED", "ERROR"]},
    "qualification": {"enum": ["SUPPORTED", "CORROBORATING", "CONTRADICTORY", "INCONCLUSIVE", null]},
    "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "bounded_statement": {"type": ["string", "null"]},
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "fact_id", "source_id", "canonical_uri", "document_sha256", "authority_scope"],
        "properties": {
          "evidence_id": {"type": "string"},
          "fact_id": {"type": "string"},
          "source_id": {"type": "string"},
          "canonical_uri": {"type": "string"},
          "document_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "authority_scope": {"type": "string"}
        }
      }
    },
    "retrieval_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query_tokens", "required_tags", "candidate_fact_count", "selected_fact_ids"],
      "properties": {
        "query_tokens": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "required_tags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "candidate_fact_count": {"type": "integer", "minimum": 0},
        "selected_fact_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "assurance_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_schema", "semantic_authority", "evidence_identity", "source_authority", "evidence_completeness", "non_inference", "frozen_result_integrity", "deterministic_serialization"],
      "properties": {
        "request_schema": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "semantic_authority": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "evidence_identity": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "source_authority": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "evidence_completeness": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "non_inference": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "frozen_result_integrity": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "deterministic_serialization": {"enum": ["PASS", "FAIL", "NOT_RUN"]}
      }
    },
    "must_not_claim": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "human_review_required": {"type": "boolean"},
    "memory_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
