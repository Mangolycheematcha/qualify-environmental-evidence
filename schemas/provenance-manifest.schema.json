{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/qualify-environmental-evidence/schemas/provenance-manifest.schema.json",
  "title": "Qualify Environmental Evidence Provenance Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "run_id", "case_id", "runtime_mode", "created_at_utc", "run_identity", "source_records", "processing_representation_records", "acquisition_group_records", "solar_geometry_records", "solar_geometry_summary", "radiometry_records", "qualification_records", "artifact_records", "transformation_records", "policy_versions", "software_environment", "terminal_result"],
  "properties": {
    "schema_version": {"const": "0.5.0"}, "manifest_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1}, "case_id": {"type": "string", "minLength": 1},
    "runtime_mode": {"enum": ["SCHEMA_FIXTURE", "EXECUTION"]}, "created_at_utc": {"type": "string", "format": "date-time"},
    "run_identity": {"$ref": "#/$defs/run_identity"},
    "source_records": {"type": "array", "items": {"$ref": "#/$defs/source_record"}},
    "processing_representation_records": {"type": "array", "items": {"$ref": "#/$defs/processing_representation_record"}},
    "acquisition_group_records": {"type": "array", "items": {"$ref": "#/$defs/acquisition_group_record"}},
    "solar_geometry_records": {"type": "array", "items": {"$ref": "#/$defs/solar_geometry_record"}},
    "solar_geometry_summary": {"$ref": "#/$defs/solar_geometry_summary"},
    "radiometry_records": {"type": "array", "items": {"$ref": "#/$defs/radiometry_record"}},
    "qualification_records": {"type": "array", "items": {"$ref": "#/$defs/qualification_record"}},
    "artifact_records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact_record"}},
    "transformation_records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/transformation_record"}},
    "policy_versions": {"$ref": "#/$defs/policy_versions"},
    "software_environment": {"$ref": "#/$defs/software_environment"},
    "terminal_result": {"$ref": "#/$defs/terminal_result"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["approved_policy_sha256", "calculated_policy_sha256_at_start", "final_policy_sha256", "input_sha256_at_start", "final_input_sha256"],
      "allOf": [{
        "if": {"required": ["approval_protocol_version"]},
        "then": {"required": ["approval_protocol_version", "approval_request_sha256", "approval_evidence_sha256", "approval_consumption_sha256", "reserved_run_id", "github_approval_url", "github_approver_login"]}
      }],
      "properties": {
        "approved_policy_sha256": {"$ref": "#/$defs/sha256"},
        "calculated_policy_sha256_at_start": {"$ref": "#/$defs/sha256"},
        "final_policy_sha256": {"$ref": "#/$defs/sha256"},
        "input_sha256_at_start": {"$ref": "#/$defs/sha256"},
        "final_input_sha256": {"$ref": "#/$defs/sha256"},
        "approved_runtime_spec_sha256": {"$ref": "#/$defs/sha256"},
        "detached_approval_sha256": {"$ref": "#/$defs/sha256"},
        "approval_protocol_version": {"const": "2.0.0"},
        "approval_request_sha256": {"$ref": "#/$defs/sha256"},
        "approval_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "approval_consumption_sha256": {"$ref": "#/$defs/sha256"},
        "reserved_run_id": {"type": "string", "minLength": 1},
        "github_approval_url": {"type": "string", "pattern": "^https://github\\.com/"},
        "github_approver_login": {"const": "Mangolycheematcha"},
        "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "first_data_network_attempt_event_id": {"type": "string", "pattern": "^NET-[0-9a-f]{32}$"},
        "first_data_network_attempt_at": {"type": "string", "format": "date-time"},
        "last_data_network_attempt_event_id": {"type": "string", "pattern": "^NET-[0-9a-f]{32}$"},
        "last_data_network_attempt_at": {"type": "string", "format": "date-time"}
      }
    },
    "solar_geometry_record": {
      "type": "object", "additionalProperties": false,
      "required": ["window", "item_id", "acquisition_datetime", "platform", "datatake_id", "mean_solar_zenith_angle", "metadata_source", "cross_check", "admissible", "exclusion_reason", "processing_baseline"],
      "properties": {
        "window": {"enum": ["PRE", "POST"]},
        "item_id": {"type": "string", "minLength": 1},
        "acquisition_datetime": {"type": "string", "format": "date-time"},
        "platform": {"type": "string", "minLength": 1},
        "datatake_id": {"type": "string", "minLength": 1},
        "mean_solar_zenith_angle": {"type": ["number", "null"]},
        "metadata_source": {"type": ["string", "null"], "minLength": 1},
        "cross_check": {"enum": ["PASS", "FAIL", "MISSING", "UNPARSEABLE"]},
        "admissible": {"type": "boolean"},
        "exclusion_reason": {"enum": ["SOLAR_GEOMETRY_OUT_OF_RANGE", "SOLAR_GEOMETRY_METADATA_UNRESOLVED", null]},
        "processing_baseline": {"type": "string", "minLength": 1}
      }
    },
    "solar_geometry_population_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["count", "minimum", "q25", "median", "q75", "maximum", "missing_count", "excluded_above_threshold_count", "excluded_unresolved_count"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "minimum": {"type": ["number", "null"]},
        "q25": {"type": ["number", "null"]},
        "median": {"type": ["number", "null"]},
        "q75": {"type": ["number", "null"]},
        "maximum": {"type": ["number", "null"]},
        "missing_count": {"type": "integer", "minimum": 0},
        "excluded_above_threshold_count": {"type": "integer", "minimum": 0},
        "excluded_unresolved_count": {"type": "integer", "minimum": 0}
      }
    },
    "solar_geometry_window_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["discovered", "admitted"],
      "properties": {
        "discovered": {"$ref": "#/$defs/solar_geometry_population_summary"},
        "admitted": {"$ref": "#/$defs/solar_geometry_population_summary"}
      }
    },
    "solar_geometry_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["pre_window", "post_window", "post_minus_pre_median_degrees", "diagnostic_only"],
      "properties": {
        "pre_window": {"$ref": "#/$defs/solar_geometry_window_summary"},
        "post_window": {"$ref": "#/$defs/solar_geometry_window_summary"},
        "post_minus_pre_median_degrees": {"type": ["number", "null"]},
        "diagnostic_only": {"const": true}
      }
    },
    "source_record": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "canonical_uri", "retrieval_uri", "publisher", "retrieved_at_utc", "version_identifier", "content_sha256", "source_asset_ids"],
      "properties": {
        "source_id": {"enum": ["CER_ACCU_PROJECT_REGISTER", "CER_PROJECT_RECORD", "CER_PUBLISHED_CEA", "MSPC_SENTINEL2_L2A"]},
        "canonical_uri": {"type": "string", "format": "uri"}, "retrieval_uri": {"type": ["string", "null"], "format": "uri"}, "publisher": {"type": "string", "minLength": 1},
        "retrieved_at_utc": {"type": "string", "format": "date-time"}, "version_identifier": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"}, "source_asset_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "processing_representation_record": {
      "type": "object", "additionalProperties": false,
      "required": ["window", "platform", "datatake_id", "mgrs_tile", "candidate_item_ids", "selected_item_id", "selection_priority", "status", "reason_codes"],
      "properties": {
        "window": {"enum": ["PRE", "POST"]},
        "platform": {"type": "string", "minLength": 1},
        "datatake_id": {"type": "string", "minLength": 1},
        "mgrs_tile": {"type": "string", "minLength": 1},
        "candidate_item_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "selected_item_id": {"type": ["string", "null"], "minLength": 1},
        "selection_priority": {"const": "VALID_SOURCE_THEN_BASELINE_THEN_PROCESSING_TIME_THEN_EQUIVALENT_ID_V1"},
        "status": {"enum": ["RESOLVED", "AMBIGUOUS"]},
        "reason_codes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/reason_code"}}
      }
    },
    "acquisition_group_record": {
      "type": "object", "additionalProperties": false,
      "required": ["window", "platform", "datatake_id", "sensing_datetime", "component_item_ids", "mgrs_tiles", "metadata_admissible", "reason_codes", "counted_toward_raster_limit"],
      "properties": {
        "window": {"enum": ["PRE", "POST"]},
        "platform": {"type": "string", "minLength": 1},
        "datatake_id": {"type": "string", "minLength": 1},
        "sensing_datetime": {"type": "string", "format": "date-time"},
        "component_item_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "mgrs_tiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "metadata_admissible": {"type": "boolean"},
        "reason_codes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/reason_code"}},
        "counted_toward_raster_limit": {"type": "boolean"}
      }
    },
    "radiometry_record": {
      "type": "object", "additionalProperties": false,
      "required": ["item_id", "acquisition_datetime", "platform", "processing_baseline", "asset_key", "canonical_asset_identity", "retrieval_uri", "scale", "offset", "quantification_value", "nodata", "metadata_source", "cross_check"],
      "properties": {
        "item_id": {"type": "string", "minLength": 1}, "acquisition_datetime": {"type": "string", "format": "date-time"},
        "platform": {"type": "string", "minLength": 1}, "processing_baseline": {"type": "string", "minLength": 1},
        "asset_key": {"enum": ["B04", "B08"]}, "canonical_asset_identity": {"type": "string", "minLength": 1},
        "retrieval_uri": {"type": ["string", "null"], "format": "uri"}, "scale": {"type": "number"}, "offset": {"type": "number"},
        "quantification_value": {"type": "number", "exclusiveMinimum": 0}, "nodata": {"type": "number"},
        "metadata_source": {"type": "string", "minLength": 1}, "cross_check": {"enum": ["PASS", "FAIL"]}
      }
    },
    "qualification_record": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_id", "is_primary", "metric", "delta_ndvi", "tau", "comparison_semantics", "execution_status", "evidence_disposition", "reason_codes"],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1}, "is_primary": {"type": "boolean"},
        "metric": {"const": "POST_MINUS_PRE_AOI_MEDIAN_PER_PIXEL_TEMPORAL_MEDIAN_NDVI"},
        "delta_ndvi": {"type": "number", "minimum": -2, "maximum": 2}, "tau": {"enum": [0.01, 0.02, 0.03, 0.05]},
        "comparison_semantics": {"const": "CANONICAL_DECIMAL_FROM_JSON_NUMBER_V1"},
        "execution_status": {"enum": ["COMPLETED", "ABSTAINED"]},
        "evidence_disposition": {"enum": ["CORROBORATING", "CONTRADICTORY", "INCONCLUSIVE"]},
        "reason_codes": {"type": "array", "uniqueItems": true, "items": {"enum": ["EFFECT_WITHIN_OPERATIONAL_INDIFFERENCE_BAND"]}}
      }
    },
    "artifact_record": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "artifact_type", "content_sha256", "produced_by", "media_type"],
      "properties": {"artifact_id": {"type": "string", "minLength": 1}, "artifact_type": {"type": "string", "minLength": 1}, "content_sha256": {"$ref": "#/$defs/sha256"}, "produced_by": {"type": "string", "minLength": 1}, "media_type": {"type": "string", "minLength": 1}}
    },
    "transformation_record": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "transformation_id", "implementation_version", "parameter_set_ref", "parameter_set_sha256", "input_artifact_refs", "output_artifact_refs", "status", "started_at_utc", "finished_at_utc", "reason_codes"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "transformation_id": {"enum": ["VALIDATE_CLAIM_CONTRACT", "CHECK_AUTHORITY_SCOPE", "RESOLVE_REGISTRY_FACTS", "RESOLVE_CEA_BOUNDARY", "SEARCH_SENTINEL2_L2A", "ALIGN_AOI_RASTERS", "APPLY_SCL_VALIDITY_MASK", "CALCULATE_AOI_VALID_COVERAGE", "CALCULATE_AOI_NDVI", "AGGREGATE_SEASONAL_WINDOWS", "QUALIFY_OBSERVATIONAL_CLAIM", "EMIT_ASSESSMENT_AND_PROVENANCE"]},
        "implementation_version": {"type": "string", "minLength": 1}, "parameter_set_ref": {"type": "string", "minLength": 1},
        "parameter_set_sha256": {"$ref": "#/$defs/sha256"}, "input_artifact_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "output_artifact_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "status": {"enum": ["COMPLETED", "SKIPPED", "FAILED"]}, "started_at_utc": {"type": "string", "format": "date-time"},
        "finished_at_utc": {"type": "string", "format": "date-time"}, "reason_codes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/reason_code"}}
      }
    },
    "reason_code": {"enum": ["CLAIM_NOT_BOUNDED", "REQUIRED_FIELD_MISSING", "RUNTIME_SPECIFICATION_NOT_FROZEN", "EVIDENCE_SOURCE_NOT_ALLOWED", "TRANSFORMATION_NOT_ALLOWED", "TRANSFORMATION_SEQUENCE_INVALID", "BOUNDARY_NOT_FROZEN", "TEMPORAL_SCOPE_NOT_FROZEN", "SEASONAL_RULE_NOT_FROZEN", "SOURCE_UNAVAILABLE", "SOURCE_VERSION_UNRESOLVED", "CANONICAL_IDENTIFIER_UNRESOLVED", "ACQUISITION_IDENTITY_UNRESOLVED", "ACQUISITION_REPRESENTATION_AMBIGUOUS", "AOI_NO_OVERLAP", "SCL_ALIGNMENT_FAILED", "PROCESSING_BASELINE_UNRESOLVED", "RADIOMETRY_METADATA_UNRESOLVED", "SOLAR_GEOMETRY_OUT_OF_RANGE", "SOLAR_GEOMETRY_METADATA_UNRESOLVED", "VALID_OBSERVATION_COVERAGE_LOW", "EFFECT_WITHIN_OPERATIONAL_INDIFFERENCE_BAND", "METADATA_INVENTORY_LIMIT_EXCEEDED", "RESOURCE_LIMIT_EXCEEDED", "EVIDENCE_CONFLICT_UNRESOLVED", "AUTHORITY_SCOPE_EXCEEDED", "CAUSALITY_UNSUPPORTED", "CARBON_QUANTITY_UNSUPPORTED", "CREDIT_VALIDITY_UNSUPPORTED", "COMPLIANCE_UNSUPPORTED", "FINANCIAL_DECISION_UNSUPPORTED", "PROVENANCE_INCOMPLETE", "PROVENANCE_HASH_MISMATCH", "APPROVAL_BINDING_INVALID", "APPROVAL_EVIDENCE_NOT_INDEPENDENT", "APPROVAL_IDENTITY_MISMATCH", "APPROVAL_RUN_ID_MISMATCH", "APPROVAL_EXPIRED", "APPROVAL_ALREADY_CONSUMED", "APPROVAL_EVIDENCE_UNAVAILABLE", "HUMAN_REVIEW_REQUIRED", "DETERMINISTIC_PROCESSING_ERROR"]},
    "policy_versions": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_sources", "transformations", "statement_templates", "forbidden_inferences", "reason_codes", "qualification_policy"],
      "properties": {"evidence_sources": {"const": "0.5.0"}, "transformations": {"const": "0.5.0"}, "statement_templates": {"const": "0.5.0"}, "forbidden_inferences": {"const": "0.5.0"}, "reason_codes": {"const": "0.5.0"}, "qualification_policy": {"const": "0.5.0"}}
    },
    "software_environment": {
      "type": "object", "additionalProperties": false,
      "required": ["code_revision", "python_version", "package_lock_sha256", "packages"],
      "properties": {"code_revision": {"type": "string", "minLength": 1}, "python_version": {"type": "string", "minLength": 1}, "package_lock_sha256": {"type": "string", "minLength": 1}, "packages": {"type": "object", "additionalProperties": {"type": "string"}}}
    },
    "terminal_result": {
      "type": "object", "additionalProperties": false,
      "required": ["assessment_artifact_ref", "assessment_sha256", "execution_status", "reason_codes", "canonicalisation_id"],
      "properties": {"assessment_artifact_ref": {"type": "string", "minLength": 1}, "assessment_sha256": {"$ref": "#/$defs/sha256"}, "execution_status": {"enum": ["COMPLETED", "ABSTAINED", "REFUSED", "ERROR"]}, "reason_codes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/reason_code"}}, "canonicalisation_id": {"const": "CANONICAL_JSON_V1"}}
    }
  }
}
