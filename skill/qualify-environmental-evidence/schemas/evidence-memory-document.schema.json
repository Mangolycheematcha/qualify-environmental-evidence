{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/qualify-environmental-evidence/schemas/evidence-memory-document.schema.json",
  "title": "Deterministic Evidence Memory Document",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_schema_version", "evidence_id", "evidence_type", "source", "subject", "facts"],
  "properties": {
    "document_schema_version": {"const": "1.0.0"},
    "evidence_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,119}$"},
    "evidence_type": {"enum": ["CER_PUBLIC_RECORD", "CER_PUBLIC_DEFINITION", "FROZEN_OBSERVATION_SUMMARY"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "publisher", "canonical_uri", "accessed_on", "retrieval_mode", "authority_scope"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "canonical_uri": {"type": "string", "format": "uri"},
        "accessed_on": {"type": "string", "format": "date"},
        "retrieval_mode": {"enum": ["CURATED_PUBLIC_FACTS", "IMMUTABLE_LOCAL_RUN_DERIVATIVE", "SYNTHETIC_TEST_FIXTURE"]},
        "authority_scope": {"enum": ["PUBLIC_REGISTRY_FACTS", "PUBLIC_SAFEGUARD_FACTS", "PUBLIC_UNIT_DEFINITION", "BOUNDED_OBSERVATION_ONLY", "SYNTHETIC_TEST_ONLY"]},
        "source_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_content_bytes": {"type": "integer", "minimum": 1},
        "redistribution_status": {"enum": ["FACTUAL_EXTRACT_ONLY_NO_RAW_REDISTRIBUTION", "LOCAL_DERIVATIVE_NOT_SOURCE_BYTES"]}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_type", "subject_id", "name"],
      "properties": {
        "subject_type": {"enum": ["ACCU_PROJECT", "SAFEGUARD_FACILITY", "UNIT_CONCEPTS", "OBSERVATIONAL_RUN"]},
        "subject_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id", "text", "claim_families", "tags", "subject_type", "subject_id", "authority_scope", "attributes"],
        "properties": {
          "fact_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,119}$"},
          "text": {"type": "string", "minLength": 1},
          "claim_families": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "subject_type": {"enum": ["ACCU_PROJECT", "SAFEGUARD_FACILITY", "UNIT_CONCEPTS", "OBSERVATIONAL_RUN"]},
          "subject_id": {"type": "string", "minLength": 1},
          "authority_scope": {"enum": ["PUBLIC_REGISTRY_FACTS", "PUBLIC_SAFEGUARD_FACTS", "PUBLIC_UNIT_DEFINITION", "BOUNDED_OBSERVATION_ONLY", "SYNTHETIC_TEST_ONLY"]},
          "assertion_key": {"type": "string", "minLength": 1},
          "assertion_value": {},
          "attributes": {"type": "object"}
        }
      }
    }
  }
}
